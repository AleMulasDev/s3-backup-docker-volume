# =============================================================================
# S3 Backup Docker Volume — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- Required ----------------------------------------------------------------

# Path inside the backup container to the data to back up
BACKUP_PATH=/backup/data

# S3-compatible endpoint URL
# Examples:
#   AWS:         https://s3.amazonaws.com
#   MinIO:       http://minio:9000
#   Wasabi:      https://s3.wasabisys.com
#   Backblaze:   https://s3.us-west-004.backblazeb2.com
#   Cloudflare:  https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://s3.amazonaws.com

# S3 credentials
S3_ACCESS_KEY=your-access-key-here
S3_SECRET_KEY=your-secret-key-here

# S3 bucket name
S3_BUCKET=my-backups

# --- Optional (uncomment to override defaults) ------------------------------

# S3 region (default: us-east-1)
#S3_REGION=us-east-1

# rclone S3 provider preset (default: Minio)
# Common values: AWS, Minio, Wasabi, B2, Cloudflare, StackPath, DigitalOcean,
#                Dreamhost, IBMCOS, Liara, ArvanCloud, Ceph, ChinaMobile, HuaweiOBS
#S3_PROVIDER=Minio

# Path prefix inside the S3 bucket (default: /)
#S3_PATH=/my-app/backups

# Cron schedule for backups (default: 0 2 * * * = daily at 2 AM UTC)
# Examples:
#   Every 6 hours:     0 */6 * * *
#   Every day at noon:  0 12 * * *
#   Every Monday 3 AM: 0 3 * * 1
#   Every 30 minutes:  */30 * * * *
#BACKUP_CRON=0 2 * * *

# Prefix for backup archive filenames (default: backup)
# Archive will be named: <prefix>-2026-02-16T02-00-00Z.tar.gz
#BACKUP_PREFIX=backup

# Number of days to keep old backups (default: 30, set to 0 to keep all)
#BACKUP_RETENTION_DAYS=30

# Regex pattern for files to exclude from backup (default: none)
# Uses grep -E (extended regex) matching against relative file paths
# Examples:
#   Exclude log files:            \.log$
#   Exclude logs and temp files:  \.(log|tmp|cache)$
#   Exclude a specific directory: ^./node_modules/
#   Multiple patterns:            \.log$|\.tmp$|^./cache/
#EXCLUDE_REGEX=

# Client-side encryption password (default: none / disabled)
# When set, all archives are encrypted with rclone crypt before upload
#ENCRYPTION_PASSWORD=

# Optional salt for encryption (enhances security)
#ENCRYPTION_SALT=

# Container timezone (default: UTC)
#TZ=UTC

# Run a backup immediately when the container starts (default: false)
#BACKUP_ON_START=false

# Exit after the first backup completes — combine with BACKUP_ON_START=true for one-shot mode (default: false)
#BACKUP_ONCE=false
